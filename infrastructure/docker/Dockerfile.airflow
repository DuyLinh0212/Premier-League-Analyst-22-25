FROM football-runtime:4.0 AS runtime
FROM apache/airflow:3.3.2
USER root
COPY --from=runtime /opt/java/openjdk /opt/java/openjdk
COPY --from=runtime /opt/spark /opt/spark
COPY --from=runtime /opt/project /opt/project
COPY --from=runtime /usr/local /opt/python-runtime
COPY orchestration/dags /opt/airflow/dags
COPY infrastructure/docker/hdfs /usr/local/bin/hdfs
RUN chmod +x /usr/local/bin/hdfs
ENV JAVA_HOME=/opt/java/openjdk SPARK_HOME=/opt/spark HDFS_BIN=/usr/local/bin/hdfs
ENV SPARK_PYTHON=/opt/python-runtime/bin/python PYSPARK_PYTHON=/opt/python-runtime/bin/python PYSPARK_DRIVER_PYTHON=/opt/python-runtime/bin/python
ENV PYTHONPATH=/opt/project:/opt/project/apps/api:/opt/project/apps/api/football:/opt/project/ml/inference:/opt/project/processing/spark:/opt/spark/python/lib/pyspark.zip:/opt/spark/python/lib/py4j-0.10.9.7-src.zip
ENV PATH=/opt/spark/bin:/opt/java/openjdk/bin:$PATH LD_LIBRARY_PATH=/opt/python-runtime/lib
RUN mkdir -p /opt/project/pipeline_runs /state && chown -R airflow:0 /opt/project/pipeline_runs /state
USER airflow
WORKDIR /opt/project
