# Addresses must be reachable FROM application/worker containers.
# Neon PostgreSQL holds only published reports and run metadata; raw/Silver stay in HDFS.
NEON_DATABASE_URL=postgresql://user:password@ep-example.neon.tech/dbname?sslmode=require
KAFKA_BOOTSTRAP_SERVERS=host.docker.internal:9092
HDFS_URI=hdfs://host.docker.internal:9000
HDFS_BASE_PATH=/premier-league
NAMENODE_HTTP_URI=http://host.docker.internal:9870
HDFS_MIN_DATANODES=3
# HADOOP_USER_NAME=existing-hdfs-user
SPARK_MASTER=local[2]
APP_NAMESPACE=premier-league-22-25
RUNTIME_IMAGE=football-runtime:4.0
API_IMAGE=football-api:4.0
WEB_IMAGE=football-web:4.0
API_PORT=8000
WEB_PORT=3000

# Source-code launchers in scripts/ use these existing containers only.
KAFKA_CONTAINER=plca-kafka
# Dependency order: PostgreSQL, Redis, API server, scheduler, DAG processor, triggerer, worker.
AIRFLOW_CONTAINERS=airflow-docker-postgres-1,airflow-docker-redis-1,airflow-docker-airflow-apiserver-1,airflow-docker-airflow-scheduler-1,airflow-docker-airflow-dag-processor-1,airflow-docker-airflow-triggerer-1,airflow-docker-airflow-worker-1
STARTUP_TIMEOUT_SECONDS=180
LOCAL_API_HOST=127.0.0.1
LOCAL_WEB_HOST=127.0.0.1
# Optional host-side overrides; set the actual published Kafka port on this machine.
# LOCAL_KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:29092
# LOCAL_HDFS_URI=hdfs://127.0.0.1:9000
# LOCAL_NAMENODE_HTTP_URI=http://127.0.0.1:9870
# LOCAL_FOOTBALL_API_URL=http://127.0.0.1:8000
